<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>dim_entreprise</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Une ligne par SIREN : informations de l'annonce la plus récente, plus les SIREN connus uniquement par leurs bilans.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Fichiers BODACC</from>
      <to>Annonces</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Annonces</from>
      <to>Avis initiaux</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Avis initiaux</from>
      <to>Registre sans espaces</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Registre sans espaces</from>
      <to>SIREN</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>SIREN</from>
      <to>SIREN valide</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>SIREN valide</from>
      <to>Type de personne</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Type de personne</from>
      <to>Forme juridique</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Forme juridique</from>
      <to>Forme en minuscules</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Forme en minuscules</from>
      <to>Colonnes (annonces)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Colonnes (annonces)</from>
      <to>Annonces et bilans</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>SIREN des bilans</from>
      <to>Sans annonce</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Sans annonce</from>
      <to>Colonnes (bilans)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Colonnes (bilans)</from>
      <to>Annonces et bilans</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Annonces et bilans</from>
      <to>Tri par SIREN, annonce récente d'abord</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Tri par SIREN, annonce récente d'abord</from>
      <to>Un SIREN par ligne</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Un SIREN par ligne</from>
      <to>Colonnes de dim_entreprise</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Colonnes de dim_entreprise</from>
      <to>dim_entreprise</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Fichiers BODACC</name>
    <type>GetFileNames</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <doNotFailIfNoFile>N</doNotFailIfNoFile>
    <dynamic_include_subfolders>N</dynamic_include_subfolders>
    <file>
      <file_required>Y</file_required>
      <filemask>${BODACC_FICHIERS}</filemask>
      <include_subfolders>N</include_subfolders>
      <name>lake://${S3_BUCKET}/raw/bodacc/</name>
    </file>
    <filefield>N</filefield>
    <filter>
      <filterfiletype>only_files</filterfiletype>
    </filter>
    <isaddresult>N</isaddresult>
    <limit>0</limit>
    <raiseAnExceptionIfNoFile>Y</raiseAnExceptionIfNoFile>
    <rownum>N</rownum>
    <attributes/>
    <GUI>
      <xloc>80</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Annonces</name>
    <type>ParquetFileInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename_field>filename</filename_field>
    <metadata_filename/>
    <nulls_when_empty>N</nulls_when_empty>
    <fields>
      <field>
        <source_field>typeavis</source_field>
        <target_field>typeavis</target_field>
        <target_type>String</target_type>
        <target_format></target_format>
        <target_length/>
        <target_precision/>
      </field>
      <field>
        <source_field>registre</source_field>
        <target_field>registre</target_field>
        <target_type>String</target_type>
        <target_format></target_format>
        <target_length/>
        <target_precision/>
      </field>
      <field>
        <source_field>listepersonnes</source_field>
        <target_field>listepersonnes</target_field>
        <target_type>String</target_type>
        <target_format></target_format>
        <target_length/>
        <target_precision/>
      </field>
      <field>
        <source_field>dateparution</source_field>
        <target_field>dateparution</target_field>
        <target_type>Date</target_type>
        <target_format></target_format>
        <target_length/>
        <target_precision/>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Avis initiaux</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Registre sans espaces</send_true_to>
    <send_false_to></send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>typeavis</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>annonce</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask></mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>432</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Registre sans espaces</name>
    <type>ReplaceString</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <in_stream_name>registre</in_stream_name>
        <out_stream_name>registre_sans_espaces</out_stream_name>
        <use_regex>N</use_regex>
        <replace_string> </replace_string>
        <replace_by_string/>
        <set_empty_string>N</set_empty_string>
        <replace_field_by_string/>
        <whole_word>N</whole_word>
        <case_sensitive>N</case_sensitive>
        <is_unicode>N</is_unicode>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>608</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>SIREN</name>
    <type>RegexEval</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <script>([0-9]{9})(?:,.*)?</script>
    <matcher>registre_sans_espaces</matcher>
    <resultfieldname>siren_trouve</resultfieldname>
    <usevar>N</usevar>
    <allowcapturegroups>Y</allowcapturegroups>
    <replacefields>N</replacefields>
    <canoneq>N</canoneq>
    <caseinsensitive>N</caseinsensitive>
    <comment>N</comment>
    <dotall>Y</dotall>
    <multiline>N</multiline>
    <unicode>N</unicode>
    <unix>N</unix>
    <fields>
      <field>
        <name>siren</name>
        <type>String</type>
        <format/>
        <group/>
        <decimal/>
        <currency/>
        <length>-1</length>
        <precision>-1</precision>
        <nullif/>
        <ifnull/>
        <trimtype>none</trimtype>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>784</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>SIREN valide</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Type de personne</send_true_to>
