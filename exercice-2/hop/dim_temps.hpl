<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>dim_temps</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Un jour par ligne, de 2000 à 2030.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Un jour par ligne</from>
      <to>N° du jour</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>N° du jour</from>
      <to>Date, année, trimestre, mois</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Date, année, trimestre, mois</from>
      <to>Colonnes de dim_temps</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Colonnes de dim_temps</from>
      <to>dim_temps</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Un jour par ligne</name>
    <type>RowGenerator</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>debut</name>
        <type>Date</type>
        <format>yyyy-MM-dd</format>
        <currency/>
        <decimal/>
        <group/>
        <nullif>2000-01-01</nullif>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <interval_in_ms>5000</interval_in_ms>
    <last_time_field>FiveSecondsAgo</last_time_field>
    <never_ending>N</never_ending>
    <limit>11323</limit>
    <row_time_field>now</row_time_field>
    <attributes/>
    <GUI>
      <xloc>80</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>N° du jour</name>
    <type>Sequence</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection/>
    <counter_name/>
    <increment_by>1</increment_by>
    <max_value>999999999</max_value>
    <schema/>
    <seqname>SEQ_</seqname>
    <start_at>0</start_at>
    <use_counter>Y</use_counter>
    <use_database>N</use_database>
    <valuename>n</valuename>
    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Date, année, trimestre, mois</name>
    <type>Calculator</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <failIfNoFile>Y</failIfNoFile>
    <calculation>
      <calc_type>ADD_DAYS</calc_type>
      <field_name>jour</field_name>
      <field_a>debut</field_a>
      <field_b>n</field_b>
      <field_c></field_c>
      <remove>N</remove>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <value_type>Date</value_type>
    </calculation>
    <calculation>
      <calc_type>YEAR_OF_DATE</calc_type>
      <field_name>annee</field_name>
      <field_a>jour</field_a>
      <field_b></field_b>
      <field_c></field_c>
      <remove>N</remove>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <value_type>Integer</value_type>
    </calculation>
    <calculation>
      <calc_type>QUARTER_OF_DATE</calc_type>
      <field_name>trimestre</field_name>
      <field_a>jour</field_a>
      <field_b></field_b>
      <field_c></field_c>
      <remove>N</remove>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <value_type>Integer</value_type>
    </calculation>
    <calculation>
      <calc_type>MONTH_OF_DATE</calc_type>
      <field_name>mois</field_name>
      <field_a>jour</field_a>
      <field_b></field_b>
      <field_c></field_c>
      <remove>N</remove>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <value_type>Integer</value_type>
    </calculation>
    <attributes/>
    <GUI>
      <xloc>432</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Colonnes de dim_temps</name>
    <type>SelectValues</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>jour</name>
        <rename></rename>
      </field>
      <field>
        <name>annee</name>
        <rename></rename>
      </field>
      <field>
        <name>trimestre</name>
        <rename></rename>
      </field>
      <field>
        <name>mois</name>
        <rename></rename>
      </field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <attributes/>
    <GUI>
      <xloc>608</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>dim_temps</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>10000</commit>
    <connection>dw</connection>
    <fields>
    </fields>
    <ignore_errors>N</ignore_errors>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_keys>N</return_keys>
    <specify_fields>N</specify_fields>
    <table>dim_temps</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>784</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
