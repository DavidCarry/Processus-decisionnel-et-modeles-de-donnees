<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>dim_territoire</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>La liste des départements, lue dans les annonces BODACC.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Fichiers BODACC</from>
      <to>Annonces</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Annonces</from>
      <to>Département renseigné</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Département renseigné</from>
      <to>Un département par code</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Un département par code</from>
      <to>Colonnes de dim_territoire</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Colonnes de dim_territoire</from>
      <to>dim_territoire</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Fichiers BODACC</name>
    <type>GetFileNames</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <doNotFailIfNoFile>N</doNotFailIfNoFile>
    <dynamic_include_subfolders>N</dynamic_include_subfolders>
    <file>
      <file_required>Y</file_required>
      <filemask>${BODACC_FICHIERS}</filemask>
      <include_subfolders>N</include_subfolders>
      <name>lake://${S3_BUCKET}/raw/bodacc/</name>
    </file>
    <filefield>N</filefield>
    <filter>
      <filterfiletype>only_files</filterfiletype>
    </filter>
    <isaddresult>N</isaddresult>
    <limit>0</limit>
    <raiseAnExceptionIfNoFile>Y</raiseAnExceptionIfNoFile>
    <rownum>N</rownum>
    <attributes/>
    <GUI>
      <xloc>80</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Annonces</name>
    <type>ParquetFileInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename_field>filename</filename_field>
    <metadata_filename/>
    <nulls_when_empty>N</nulls_when_empty>
    <fields>
      <field>
        <source_field>numerodepartement</source_field>
        <target_field>numerodepartement</target_field>
        <target_type>String</target_type>
        <target_format></target_format>
        <target_length/>
        <target_precision/>
      </field>
      <field>
        <source_field>departement_nom_officiel</source_field>
        <target_field>departement_nom_officiel</target_field>
        <target_type>String</target_type>
        <target_format></target_format>
        <target_length/>
        <target_precision/>
      </field>
      <field>
        <source_field>region_code</source_field>
        <target_field>region_code</target_field>
        <target_type>Integer</target_type>
        <target_format></target_format>
        <target_length/>
        <target_precision/>
      </field>
      <field>
        <source_field>region_nom_officiel</source_field>
        <target_field>region_nom_officiel</target_field>
        <target_type>String</target_type>
        <target_format></target_format>
        <target_length/>
        <target_precision/>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Département renseigné</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Un département par code</send_true_to>
    <send_false_to></send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>numerodepartement</leftvalue>
        <function>IS NOT NULL</function>
        <rightvalue/>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>432</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Un département par code</name>
    <type>UniqueRowsByHashSet</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <store_values>Y</store_values>
    <reject_duplicate_row>N</reject_duplicate_row>
    <error_description/>
    <fields>
      <field>
        <name>numerodepartement</name>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>608</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Colonnes de dim_territoire</name>
    <type>SelectValues</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>numerodepartement</name>
        <rename>departement_code</rename>
      </field>
      <field>
        <name>departement_nom_officiel</name>
        <rename>departement_nom</rename>
      </field>
      <field>
        <name>region_code</name>
        <rename></rename>
      </field>
      <field>
        <name>region_nom_officiel</name>
        <rename>region_nom</rename>
      </field>
      <select_unspecified>N</select_unspecified>
      <meta>
        <name>region_code</name>
        <rename>region_code</rename>
        <type>String</type>
        <length>-2</length>
        <precision>-2</precision>
        <conversion_mask>#</conversion_mask>
        <date_format_lenient>false</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>false</lenient_string_to_number>
        <encoding/>
        <decimal_symbol/>
        <grouping_symbol/>
        <currency_symbol/>
        <storage_type/>
      </meta>
    </fields>
    <attributes/>
    <GUI>
      <xloc>784</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>dim_territoire</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>10000</commit>
    <connection>dw</connection>
    <fields>
    </fields>
    <ignore_errors>N</ignore_errors>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_keys>N</return_keys>
    <specify_fields>N</specify_fields>
    <table>dim_territoire</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>960</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
