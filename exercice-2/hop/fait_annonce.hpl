<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>fait_annonce</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Une ligne par annonce initiale de création ou de radiation.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Fichiers BODACC</from>
      <to>Annonces</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Annonces</from>
      <to>Avis initiaux</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Avis initiaux</from>
      <to>Registre sans espaces</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Registre sans espaces</from>
      <to>SIREN</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>SIREN</from>
      <to>Création ou radiation ?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Création ou radiation ?</from>
      <to>Texte de radiation en minuscules</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Création ou radiation ?</from>
      <to>Pas de motif</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Texte de radiation en minuscules</from>
      <to>Motif de radiation</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Motif de radiation</from>
      <to>Motif office</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Motif de radiation</from>
      <to>Motif liquidation</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Motif de radiation</from>
      <to>Motif autre</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Pas de motif</from>
      <to>Motif vide</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Motif office</from>
      <to>Colonnes de fait_annonce</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Motif liquidation</from>
      <to>Colonnes de fait_annonce</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Motif autre</from>
      <to>Colonnes de fait_annonce</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Motif vide</from>
      <to>Colonnes de fait_annonce</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Colonnes de fait_annonce</from>
      <to>fait_annonce</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Fichiers BODACC</name>
    <type>GetFileNames</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <doNotFailIfNoFile>N</doNotFailIfNoFile>
    <dynamic_include_subfolders>N</dynamic_include_subfolders>
    <file>
      <file_required>Y</file_required>
      <filemask>${BODACC_FICHIERS}</filemask>
      <include_subfolders>N</include_subfolders>
      <name>lake://${S3_BUCKET}/raw/bodacc/</name>
    </file>
    <filefield>N</filefield>
    <filter>
      <filterfiletype>only_files</filterfiletype>
    </filter>
    <isaddresult>N</isaddresult>
    <limit>0</limit>
    <raiseAnExceptionIfNoFile>Y</raiseAnExceptionIfNoFile>
    <rownum>N</rownum>
    <attributes/>
    <GUI>
      <xloc>80</xloc>
      <yloc>192</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Annonces</name>
    <type>ParquetFileInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename_field>filename</filename_field>
    <metadata_filename/>
    <nulls_when_empty>N</nulls_when_empty>
    <fields>
      <field>
        <source_field>id</source_field>
        <target_field>id</target_field>
        <target_type>String</target_type>
        <target_format></target_format>
        <target_length/>
        <target_precision/>
      </field>
      <field>
        <source_field>dateparution</source_field>
        <target_field>dateparution</target_field>
        <target_type>Date</target_type>
        <target_format></target_format>
        <target_length/>
        <target_precision/>
      </field>
      <field>
        <source_field>typeavis</source_field>
        <target_field>typeavis</target_field>
        <target_type>String</target_type>
        <target_format></target_format>
        <target_length/>
        <target_precision/>
      </field>
      <field>
        <source_field>familleavis</source_field>
        <target_field>familleavis</target_field>
        <target_type>String</target_type>
        <target_format></target_format>
        <target_length/>
        <target_precision/>
      </field>
      <field>
        <source_field>registre</source_field>
        <target_field>registre</target_field>
        <target_type>String</target_type>
        <target_format></target_format>
        <target_length/>
        <target_precision/>
      </field>
      <field>
        <source_field>numerodepartement</source_field>
        <target_field>numerodepartement</target_field>
        <target_type>String</target_type>
        <target_format></target_format>
        <target_length/>
        <target_precision/>
      </field>
      <field>
        <source_field>radiationaurcs</source_field>
        <target_field>radiationaurcs</target_field>
        <target_type>String</target_type>
        <target_format></target_format>
        <target_length/>
        <target_precision/>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>192</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Avis initiaux</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Registre sans espaces</send_true_to>
    <send_false_to></send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>typeavis</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>annonce</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask></mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>432</xloc>
      <yloc>192</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Registre sans espaces</name>
    <type>ReplaceString</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <in_stream_name>registre</in_stream_name>
        <out_stream_name>registre_sans_espaces</out_stream_name>
        <use_regex>N</use_regex>
        <replace_string> </replace_string>
        <replace_by_string/>
        <set_empty_string>N</set_empty_string>
        <replace_field_by_string/>
        <whole_word>N</whole_word>
        <case_sensitive>N</case_sensitive>
        <is_unicode>N</is_unicode>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>608</xloc>
      <yloc>192</yloc>
    </GUI>
  </transform>
  <transform>
    <name>SIREN</name>
    <type>RegexEval</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <script>([0-9]{9})(?:,.*)?</script>
    <matcher>registre_sans_espaces</matcher>
    <resultfieldname>siren_trouve</resultfieldname>
    <usevar>N</usevar>
    <allowcapturegroups>Y</allowcapturegroups>
    <replacefields>N</replacefields>
    <canoneq>N</canoneq>
    <caseinsensitive>N</caseinsensitive>
    <comment>N</comment>
    <dotall>Y</dotall>
    <multiline>N</multiline>
    <unicode>N</unicode>
    <unix>N</unix>
    <fields>
      <field>
        <name>siren</name>
        <type>String</type>
        <format/>
        <group/>
        <decimal/>
        <currency/>
        <length>-1</length>
        <precision>-1</precision>
        <nullif/>
        <ifnull/>
        <trimtype>none</trimtype>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>784</xloc>
      <yloc>192</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Création ou radiation ?</name>
    <type>SwitchCase</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fieldname>familleavis</fieldname>
    <use_contains>N</use_contains>
    <case_value_type>String</case_value_type>
    <case_value_format/>
    <case_value_decimal/>
    <case_value_group/>
    <default_target_transform>Pas de motif</default_target_transform>
    <cases>
      <case>
        <value>radiation</value>
        <target_transform>Texte de radiation en minuscules</target_transform>
      </case>
    </cases>
    <attributes/>
    <GUI>
      <xloc>960</xloc>
      <yloc>192</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Texte de radiation en minuscules</name>
    <type>StringOperations</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <in_stream_name>radiationaurcs</in_stream_name>
        <out_stream_name>radiation_minuscules</out_stream_name>
        <trim_type>none</trim_type>
        <lower_upper>lower</lower_upper>
        <padding_type>none</padding_type>
        <pad_char/>
        <pad_len/>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>960</xloc>
      <yloc>64</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Motif de radiation</name>
    <type>SwitchCase</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fieldname>radiation_minuscules</fieldname>
    <use_contains>Y</use_contains>
    <case_value_type>String</case_value_type>
    <case_value_format/>
    <case_value_decimal/>
    <case_value_group/>
    <default_target_transform>Motif autre</default_target_transform>
    <cases>
      <case>
        <value>radiation d'office</value>
        <target_transform>Motif office</target_transform>
      </case>
      <case>
        <value>liquidation</value>
        <target_transform>Motif liquidation</target_transform>
      </case>
    </cases>
    <attributes/>
    <GUI>
      <xloc>1136</xloc>
      <yloc>64</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Motif office</name>
    <type>Constant</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>motif_radiation</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal/>
        <group/>
        <nullif>office</nullif>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>1312</xloc>
      <yloc>32</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Motif liquidation</name>
    <type>Constant</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>motif_radiation</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal/>
        <group/>
        <nullif>liquidation</nullif>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>1312</xloc>
      <yloc>112</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Motif autre</name>
    <type>Constant</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>motif_radiation</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal/>
        <group/>
        <nullif>autre</nullif>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>1312</xloc>
      <yloc>192</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Pas de motif</name>
    <type>StringOperations</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <in_stream_name>radiationaurcs</in_stream_name>
        <out_stream_name>radiation_minuscules</out_stream_name>
        <trim_type>none</trim_type>
        <lower_upper>lower</lower_upper>
        <padding_type>none</padding_type>
        <pad_char/>
        <pad_len/>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>1136</xloc>
      <yloc>288</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Motif vide</name>
    <type>Constant</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>motif_radiation</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal/>
        <group/>
        <nullif></nullif>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>1312</xloc>
      <yloc>288</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Colonnes de fait_annonce</name>
    <type>SelectValues</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>id</name>
        <rename>annonce_id</rename>
      </field>
      <field>
        <name>siren</name>
        <rename></rename>
      </field>
      <field>
        <name>dateparution</name>
        <rename>jour</rename>
      </field>
      <field>
        <name>numerodepartement</name>
        <rename>departement_code</rename>
      </field>
      <field>
