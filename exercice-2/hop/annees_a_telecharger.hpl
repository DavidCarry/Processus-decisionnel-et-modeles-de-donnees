<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>annees_a_telecharger</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Années du BODACC à télécharger : celles absentes du data lake, plus l'année en cours, qui change tous les jours.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Années possibles</from>
      <to>Année</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Année</from>
      <to>Date du jour</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Date du jour</from>
      <to>Chemin du data lake</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Chemin du data lake</from>
      <to>Année en cours, nom du fichier</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Année en cours, nom du fichier</from>
      <to>Jusqu'à l'année en cours</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Jusqu'à l'année en cours</from>
      <to>Déjà dans le data lake ?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Déjà dans le data lake ?</from>
      <to>Présent ?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Présent ?</from>
      <to>Année en cours ?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Présent ?</from>
      <to>Années à télécharger</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Année en cours ?</from>
      <to>Années à télécharger</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Années possibles</name>
    <type>RowGenerator</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
    </fields>
    <interval_in_ms>5000</interval_in_ms>
    <last_time_field>FiveSecondsAgo</last_time_field>
    <never_ending>N</never_ending>
    <limit>100</limit>
    <row_time_field>now</row_time_field>
    <attributes/>
    <GUI>
      <xloc>80</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Année</name>
    <type>Sequence</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection/>
    <counter_name/>
    <increment_by>1</increment_by>
    <max_value>999999999</max_value>
    <schema/>
    <seqname>SEQ_</seqname>
    <start_at>2008</start_at>
    <use_counter>Y</use_counter>
    <use_database>N</use_database>
    <valuename>annee</valuename>
    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Date du jour</name>
    <type>SystemInfo</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>aujourd_hui</name>
        <type>system date (fixed)</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>432</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Chemin du data lake</name>
    <type>GetVariable</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>dossier</name>
        <variable>lake://${S3_BUCKET}/raw/bodacc/</variable>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>extension</name>
        <variable>.parquet</variable>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>608</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Année en cours, nom du fichier</name>
    <type>Calculator</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <failIfNoFile>Y</failIfNoFile>
    <calculation>
      <calc_type>YEAR_OF_DATE</calc_type>
      <field_name>annee_en_cours</field_name>
      <field_a>aujourd_hui</field_a>
      <field_b></field_b>
      <field_c></field_c>
      <remove>N</remove>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <value_type>Integer</value_type>
    </calculation>
    <calculation>
      <calc_type>ADD3</calc_type>
      <field_name>fichier</field_name>
      <field_a>dossier</field_a>
      <field_b>annee</field_b>
      <field_c>extension</field_c>
      <remove>N</remove>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <value_type>String</value_type>
    </calculation>
    <attributes/>
    <GUI>
      <xloc>784</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Jusqu'à l'année en cours</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Déjà dans le data lake ?</send_true_to>
    <send_false_to></send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>annee</leftvalue>
        <function>&lt;=</function>
        <rightvalue>annee_en_cours</rightvalue>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>960</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Déjà dans le data lake ?</name>
    <type>FileExists</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <addresultfilenames>N</addresultfilenames>
    <filenamefield>fichier</filenamefield>
    <filetypefieldname/>
    <includefiletype>N</includefiletype>
    <resultfieldname>present</resultfieldname>
    <attributes/>
    <GUI>
      <xloc>1136</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Présent ?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Année en cours ?</send_true_to>
    <send_false_to>Années à télécharger</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>present</leftvalue>
        <function>TRUE</function>
        <rightvalue/>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>1312</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Année en cours ?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Années à télécharger</send_true_to>
    <send_false_to></send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>annee</leftvalue>
        <function>=</function>
        <rightvalue>annee_en_cours</rightvalue>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>1488</xloc>
      <yloc>32</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Années à télécharger</name>
    <type>RowsToResult</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>

    <attributes/>
    <GUI>
      <xloc>1664</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
