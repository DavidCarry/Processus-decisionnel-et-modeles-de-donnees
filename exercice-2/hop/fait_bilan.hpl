<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>fait_bilan</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Un bilan par entreprise et par exercice, avec le chiffre d'affaires, le résultat et l'impôt sur les bénéfices lus dans la liasse fiscale.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Bilans et codes de la liasse</from>
      <to>Comptes sociaux (C ou S)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Comptes sociaux (C ou S)</from>
      <to>Clôture depuis 2000</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Clôture depuis 2000</from>
      <to>Clôture jusqu'à 2030</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Clôture jusqu'à 2030</from>
      <to>SIREN valide</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>SIREN valide</from>
      <to>Tri par SIREN, exercice, type</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Tri par SIREN, exercice, type</from>
      <to>Un bilan par exercice (C avant S)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Un bilan par exercice (C avant S)</from>
      <to>Régime normal ou simplifié ?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Régime normal ou simplifié ?</from>
      <to>Régime normal</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Régime normal ou simplifié ?</from>
      <to>Lignes vides du CA à zéro</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Régime normal</from>
      <to>Colonnes (normal)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lignes vides du CA à zéro</from>
      <to>Régime simplifié</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Régime simplifié</from>
      <to>CA nul = non publié</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>CA nul = non publié</from>
      <to>Colonnes (simplifié)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Colonnes (normal)</from>
      <to>Résultat publié ?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Colonnes (simplifié)</from>
      <to>Résultat publié ?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Résultat publié ?</from>
      <to>Impôt vide = 0</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Résultat publié ?</from>
      <to>fait_bilan</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Impôt vide = 0</from>
      <to>fait_bilan</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Bilans et codes de la liasse</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>duckdb</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT siren, date_cloture_exercice AS date_cloture, type_bilan, confidentiality AS confidentialite,
       liasse['FL'] AS fl, liasse['HN'] AS hn, liasse['HK'] AS hk,
       liasse['210'] AS l210, liasse['214'] AS l214, liasse['218'] AS l218,
       liasse['310'] AS l310, liasse['306'] AS l306
FROM read_parquet('s3://${S3_BUCKET}/raw/inpi/donnees_financieres.parquet')</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>80</xloc>
      <yloc>192</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Comptes sociaux (C ou S)</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Clôture depuis 2000</send_true_to>
    <send_false_to></send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>type_bilan</leftvalue>
        <function>IN LIST</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>C;S</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask></mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>192</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Clôture depuis 2000</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Clôture jusqu'à 2030</send_true_to>
    <send_false_to></send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>date_cloture</leftvalue>
        <function>&gt;=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>Date</type>
          <text>2000-01-01</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask>yyyy-MM-dd</mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>432</xloc>
      <yloc>192</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Clôture jusqu'à 2030</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>SIREN valide</send_true_to>
    <send_false_to></send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>date_cloture</leftvalue>
        <function>&lt;=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>Date</type>
          <text>2030-12-31</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask>yyyy-MM-dd</mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>608</xloc>
      <yloc>192</yloc>
    </GUI>
  </transform>
  <transform>
    <name>SIREN valide</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Tri par SIREN, exercice, type</send_true_to>
    <send_false_to></send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>siren</leftvalue>
        <function>REGEXP</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>[0-9]{9}</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask></mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>784</xloc>
      <yloc>192</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Tri par SIREN, exercice, type</name>
    <type>SortRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <directory>${java.io.tmpdir}</directory>
    <prefix>tri</prefix>
    <sort_size>1000000</sort_size>
    <free_memory/>
    <compress>Y</compress>
    <compress_variable/>
    <unique_rows>N</unique_rows>
    <fields>
      <field>
        <name>siren</name>
        <ascending>Y</ascending>
        <case_sensitive>Y</case_sensitive>
        <collator_enabled>N</collator_enabled>
        <collator_strength>0</collator_strength>
        <presorted>N</presorted>
      </field>
      <field>
        <name>date_cloture</name>
        <ascending>Y</ascending>
        <case_sensitive>Y</case_sensitive>
        <collator_enabled>N</collator_enabled>
        <collator_strength>0</collator_strength>
        <presorted>N</presorted>
      </field>
      <field>
        <name>type_bilan</name>
        <ascending>Y</ascending>
        <case_sensitive>Y</case_sensitive>
        <collator_enabled>N</collator_enabled>
        <collator_strength>0</collator_strength>
        <presorted>N</presorted>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>960</xloc>
      <yloc>192</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Un bilan par exercice (C avant S)</name>
    <type>Unique</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <count_rows>N</count_rows>
    <count_field/>
    <reject_duplicate_row>N</reject_duplicate_row>
    <error_description/>
    <fields>
      <field>
        <name>siren</name>
        <case_insensitive>N</case_insensitive>
      </field>
      <field>
        <name>date_cloture</name>
        <case_insensitive>N</case_insensitive>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>1136</xloc>
      <yloc>192</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Régime normal ou simplifié ?</name>
    <type>SwitchCase</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fieldname>type_bilan</fieldname>
    <use_contains>N</use_contains>
    <case_value_type>String</case_value_type>
    <case_value_format/>
    <case_value_decimal/>
    <case_value_group/>
    <default_target_transform>Lignes vides du CA à zéro</default_target_transform>
    <cases>
      <case>
        <value>C</value>
        <target_transform>Régime normal</target_transform>
      </case>
    </cases>
    <attributes/>
    <GUI>
      <xloc>1312</xloc>
      <yloc>192</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Régime normal</name>
    <type>Calculator</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <failIfNoFile>Y</failIfNoFile>
    <calculation>
      <calc_type>COPY_FIELD</calc_type>
      <field_name>chiffre_affaires</field_name>
      <field_a>fl</field_a>
      <field_b></field_b>
      <field_c></field_c>
      <remove>N</remove>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <value_type>Integer</value_type>
    </calculation>
    <calculation>
      <calc_type>COPY_FIELD</calc_type>
      <field_name>resultat</field_name>
      <field_a>hn</field_a>
      <field_b></field_b>
      <field_c></field_c>
      <remove>N</remove>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <value_type>Integer</value_type>
    </calculation>
    <calculation>
      <calc_type>COPY_FIELD</calc_type>
      <field_name>impot_benefices</field_name>
      <field_a>hk</field_a>
      <field_b></field_b>
      <field_c></field_c>
      <remove>N</remove>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <value_type>Integer</value_type>
    </calculation>
    <attributes/>
    <GUI>
      <xloc>1488</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Lignes vides du CA à zéro</name>
    <type>IfNull</type>
