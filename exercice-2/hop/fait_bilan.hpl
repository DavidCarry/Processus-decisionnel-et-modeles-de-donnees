    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <failIfNoFile>Y</failIfNoFile>
    <calculation>
      <calc_type>ADD3</calc_type>
      <field_name>chiffre_affaires</field_name>
      <field_a>l210</field_a>
      <field_b>l214</field_b>
      <field_c>l218</field_c>
      <remove>N</remove>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <value_type>Integer</value_type>
    </calculation>
    <calculation>
      <calc_type>COPY_FIELD</calc_type>
      <field_name>resultat</field_name>
      <field_a>l310</field_a>
      <field_b></field_b>
      <field_c></field_c>
      <remove>N</remove>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <value_type>Integer</value_type>
    </calculation>
    <calculation>
      <calc_type>COPY_FIELD</calc_type>
      <field_name>impot_benefices</field_name>
      <field_a>l306</field_a>
      <field_b></field_b>
      <field_c></field_c>
      <remove>N</remove>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <value_type>Integer</value_type>
    </calculation>
    <attributes/>
    <GUI>
      <xloc>1664</xloc>
      <yloc>288</yloc>
    </GUI>
  </transform>
  <transform>
