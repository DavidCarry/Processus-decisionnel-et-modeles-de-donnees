    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>l210</name>
        <value>0</value>
        <mask/>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>l214</name>
        <value>0</value>
        <mask/>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>l218</name>
        <value>0</value>
        <mask/>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <valuetypes>
    </valuetypes>
    <selectFields>Y</selectFields>
    <selectValuesType>N</selectValuesType>
    <replaceAllByValue/>
    <replaceAllMask/>
    <setEmptyStringAll>N</setEmptyStringAll>
    <attributes/>
    <GUI>
      <xloc>1488</xloc>
      <yloc>288</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Régime simplifié</name>
    <type>Calculator</type>
    <description/>
